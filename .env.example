# Copy to .env and fill in. Never commit .env.
# Document every variable here with a short comment.

# --- apps/api (FastAPI) ---
# Google Gemini key (free tier works): https://aistudio.google.com/apikey
# Without it, photo extraction is disabled; samples, CSV and template explanations still work.
GEMINI_API_KEY=
# Optional model override (must support image input).
# GEMINI_MODEL=gemini-3.8-flash
# Comma-separated web origins allowed to call the API (*.vercel.app is always allowed).
# CORS_ORIGINS=http://localhost:3000

# --- apps/web (Next.js) ---
# Base URL of the API, e.g. http://localhost:8000 or the Render URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
